{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/client",
  "redirects": [
    {
      "source": "/login/",
      "destination": "/login.html",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/login.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/api/[...path]"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 300
    },
    "api/runtime-monitor.ts": {
      "maxDuration": 30,
      "experimentalTriggers": [{ "type": "schedule/v1beta" }]
    }
  },
  "schedules": {
    "runtime-monitor": {
      "schedule": "*/15 * * * *",
      "jitter": 15,
      "function": "api/runtime-monitor"
    }
  }
}
