{
	"name": "socratink",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "pnpm@11.1.1",
	"engines": {
		"node": ">=22.19.0",
		"pnpm": ">=11 <12"
	},
	"scripts": {
		"dev": "vite build --config vite.config.ui.ts && node --env-file-if-exists=src/ui/.env.local --watch src/server.ts",
		"dev:phone": "vite build --config vite.config.ui.ts && HOST=0.0.0.0 node --env-file-if-exists=src/ui/.env.local --watch src/server.ts",
		"build": "vite build && vite build --config vite.config.ui.ts && node scripts/preview-probe.mjs",
		"build:ui": "vite build --config vite.config.ui.ts",
		"check": "pnpm check:file-size && pnpm check:structure && pnpm check:unused && pnpm check:types && pnpm test:chat-model && pnpm test:model-route && pnpm test:database-config && pnpm test:session && pnpm test:session-client && pnpm test:sign-in && pnpm test:auth-db && pnpm test:conversation-index && pnpm test:guest-turns && pnpm test:oauth && pnpm test:questionnaire && pnpm test:present-question && pnpm test:reveal && pnpm test:reveal-ui && pnpm test:history && pnpm test:ask-before-reveal && pnpm test:conversation && pnpm test:chat-turns && pnpm test:live-reply && pnpm test:learner-text && pnpm test:sound-cues && pnpm test:menu && pnpm test:cross-tab && pnpm test:tool-card && pnpm test:thinking && pnpm test:chat-markdown && pnpm test:dictation && pnpm test:composer && pnpm test:steering && pnpm test:client-id && pnpm test:runtime-monitor && pnpm test:tutor-probe && pnpm test:tutor-eval && pnpm test:durable && pnpm test:unlisted && pnpm build && pnpm test:preview-probe && pnpm test:static-routing && pnpm test:feedback",
		"check:file-size": "node --test scripts/check-file-size.test.mjs && node scripts/check-file-size.mjs",
		"check:structure": "node --test scripts/check-structure.test.mjs && node scripts/check-structure.mjs",
		"check:unused": "knip --no-progress",
		"check:types": "tsc --noEmit",
		"smoke": "node scripts/smoke.mjs",
		"smoke:request-path": "node scripts/request-path-smoke.mjs",
		"smoke:postgres": "node scripts/postgres-smoke.mjs",
		"test:chat-model": "node scripts/chat-model.test.mjs",
		"test:model-route": "node --test scripts/model-route.test.mjs",
		"test:database-config": "node --test scripts/database-config.test.mjs",
		"test:session": "node --test scripts/session.test.mjs",
		"test:session-client": "node --test scripts/session-client.test.mjs",
		"test:sign-in": "node --test scripts/sign-in-return.test.mjs scripts/login-provider-focus.test.mjs",
		"test:auth-db": "node --test scripts/auth-db.test.mjs",
		"test:conversation-index": "node --test scripts/conversation-index.test.mjs",
		"test:guest-turns": "node --test scripts/guest-turns.test.mjs",
		"test:oauth": "node --test scripts/oauth.test.mjs",
		"test:questionnaire": "node --test scripts/questionnaire-ui.test.mjs",
		"test:present-question": "node --test scripts/present-question.test.mjs scripts/question-choice-shuffle.test.mjs",
		"test:reveal": "node --test scripts/reveal.test.mjs",
		"test:history": "node --import tsx --test scripts/history-empty.test.mjs",
		"test:reveal-ui": "node --import tsx --test scripts/reveal-ui.test.mjs",
		"test:ask-before-reveal": "node --test scripts/ask-before-reveal.test.mjs",
		"test:steering": "node --test scripts/steering.test.mjs",
		"test:conversation": "node --test scripts/conversation-client.test.mjs scripts/storage-failure.test.mjs scripts/storage-navigation-failure.test.mjs scripts/conversation-controls.test.mjs",
		"test:chat-turns": "node --test scripts/chat-turns.test.mjs",
		"test:live-reply": "node --test scripts/live-reply.test.mjs",
		"test:learner-text": "node --test scripts/learner-text.test.mjs",
		"test:cross-tab": "node --test scripts/cross-tab.test.mjs scripts/start-over-empty-session.test.mjs scripts/start-over-work-at-risk.test.mjs scripts/start-over-loss-description.test.mjs",
		"test:sound-cues": "node --test scripts/sound-cues.test.mjs",
		"test:menu": "node --test --test-concurrency=1 scripts/menu-control-accessibility.test.mjs scripts/menu-focus-return.test.mjs scripts/large-text-dialogs.test.mjs",
		"test:tool-card": "node --test scripts/tool-card.test.mjs",
		"test:thinking": "node --test scripts/thinking.test.mjs",
		"test:chat-markdown": "node --import tsx --test scripts/chat-markdown.test.mjs",
		"test:composer": "node --test --test-concurrency=1 scripts/composer-tap-focus.test.mjs scripts/composer-draft-selection.test.mjs",
		"test:dictation": "node --test scripts/dictation.test.mjs",
		"test:client-id": "node --test scripts/client-id.test.mjs",
		"test:static-routing": "node --test scripts/static-routing.test.mjs scripts/health.test.mjs",
		"test:runtime-monitor": "node --test scripts/runtime-monitor.test.mjs scripts/monitor-dispatch.test.mjs scripts/monitor-cadence.test.mjs",
		"test:tutor-probe": "node --test scripts/tutor-probe.test.mjs",
		"test:tutor-eval": "node --test evals/tutor/*.test.ts",
		"eval:tutor": "node evals/tutor/cli.ts",
		"eval:tutor:live": "node evals/tutor/live.ts",
		"eval:tutor:ci": "node evals/tutor/remote.ts",
		"eval:tutor:doctor": "node evals/tutor/doctor.ts",
		"test:preview-probe": "node --test scripts/preview-probe.test.mjs",
		"test:durable": "node --test src/inference/*.test.ts src/learning/*.test.ts src/server/durable/*.test.ts scripts/durable-storage.test.mjs scripts/durable-engine.test.mjs scripts/durable-reconnect.test.mjs scripts/feedback-agent.test.mjs",
		"test:durable:postgres": "DURABLE_TEST_POSTGRES=1 node --test scripts/durable-storage.test.mjs scripts/conversation-index.test.mjs scripts/auth-db.test.mjs",
		"smoke:durable": "node scripts/durable-smoke.mjs",
		"verify:formal": "node scripts/verify-formal.mjs",
		"smoke:durable:postgres": "pnpm build && node scripts/durable-postgres-smoke.mjs",
		"test:unlisted": "node scripts/unlisted-tests.mjs",
		"test:feedback": "node --test scripts/feedback-message.test.mjs scripts/feedback-route.test.mjs"
	},
	"dependencies": {
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@hono/node-server": "^2.1.6",
		"@valibot/to-json-schema": "1.3.0",
		"@vercel/functions": "3.9.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "4.13.17",
		"lucide-react": "^1.79.0",
		"pg": "^8.23.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.1",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.1",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^26.1.0",
		"knip": "^6.47.0",
		"playwright": "1.65.0",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.1.2"
	}
}
