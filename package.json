{
	"name": "socratink",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "pnpm@11.1.1",
	"engines": {
		"node": ">=22.19.0",
		"pnpm": ">=11 <12"
	},
	"scripts": {
		"dev": "vite build --config vite.config.ui.ts && node --watch src/server.ts",
		"dev:phone": "vite build --config vite.config.ui.ts && HOST=0.0.0.0 node --watch src/server.ts",
		"build": "vite build && vite build --config vite.config.ui.ts",
		"build:ui": "vite build --config vite.config.ui.ts",
		"audit:trellis": "trellis audit .",
		"audit:trellis:baseline": "mkdir -p .audit && trellis audit . --json --out .audit/baseline.json",
		"check": "pnpm check:file-size && pnpm check:types && pnpm test:chat-model && pnpm test:model-route && pnpm test:database-config && pnpm test:session && pnpm test:session-client && pnpm test:credentials && pnpm test:auth-db && pnpm test:guest-turns && pnpm test:oauth && pnpm test:openai-key && pnpm test:questionnaire && pnpm test:present-question && pnpm test:reveal && pnpm test:reveal-ui && pnpm test:conversation && pnpm test:chat-turns && pnpm test:live-reply && pnpm test:tool-card && pnpm test:thinking && pnpm test:chat-markdown && pnpm test:dictation && pnpm test:steering && pnpm test:client-id && pnpm test:runtime-monitor && pnpm test:durable && pnpm build && pnpm test:static-routing",
		"check:file-size": "node --test scripts/check-file-size.test.mjs && node scripts/check-file-size.mjs",
		"check:types": "tsc --noEmit",
		"smoke": "node scripts/smoke.mjs",
		"smoke:request-path": "node scripts/request-path-smoke.mjs",
		"smoke:postgres": "node scripts/postgres-smoke.mjs",
		"test:chat-model": "node scripts/chat-model.test.mjs",
		"test:model-route": "node --test scripts/model-route.test.mjs",
		"test:database-config": "node --test scripts/database-config.test.mjs",
		"test:session": "node --test scripts/session.test.mjs",
		"test:session-client": "node --test scripts/session-client.test.mjs",
		"test:credentials": "node --test scripts/credentials.test.mjs",
		"test:auth-db": "node --test scripts/auth-db.test.mjs",
		"test:guest-turns": "node --test scripts/guest-turns.test.mjs",
		"test:oauth": "node --test scripts/oauth.test.mjs",
		"test:openai-key": "node --test scripts/openai-key.test.mjs",
		"test:questionnaire": "node --test scripts/questionnaire-ui.test.mjs",
		"test:present-question": "node --test scripts/present-question.test.mjs",
		"test:reveal": "node --test scripts/reveal.test.mjs",
		"test:reveal-ui": "node --test scripts/reveal-ui.test.mjs",
		"test:steering": "node --test scripts/steering.test.mjs",
		"test:conversation": "node --test scripts/conversation-client.test.mjs",
		"test:chat-turns": "node --test scripts/chat-turns.test.mjs",
		"test:live-reply": "node --test scripts/live-reply.test.mjs",
		"test:tool-card": "node --test scripts/tool-card.test.mjs",
		"test:thinking": "node --test scripts/thinking.test.mjs",
		"test:chat-markdown": "node --test scripts/chat-markdown.test.mjs",
		"test:dictation": "node --test scripts/dictation.test.mjs",
		"test:client-id": "node --test scripts/client-id.test.mjs",
		"test:static-routing": "node --test scripts/static-routing.test.mjs",
		"test:runtime-monitor": "node --test scripts/runtime-monitor.test.mjs scripts/monitor-dispatch.test.mjs scripts/monitor-cadence.test.mjs",
		"test:durable": "node --test src/inference/*.test.ts src/learning/*.test.ts src/server/durable/*.test.ts scripts/durable-storage.test.mjs scripts/durable-engine.test.mjs scripts/durable-reconnect.test.mjs",
		"test:durable:postgres": "DURABLE_TEST_POSTGRES=1 node --test scripts/durable-storage.test.mjs",
		"smoke:durable": "node scripts/durable-smoke.mjs",
		"smoke:durable:postgres": "pnpm build && node scripts/durable-postgres-smoke.mjs"
	},
	"dependencies": {
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@hono/node-server": "^2.1.6",
		"@valibot/to-json-schema": "1.3.0",
		"@vercel/functions": "3.9.5",
		"hono": "4.13.17",
		"pg": "^8.23.0",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/pg": "^8.23.1",
		"playwright": "1.65.0",
		"typescript": "^7.0.2",
		"vite": "^8.1.2"
	}
}
